<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="suitespk.Admin" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <script>
        if (localStorage["username"] == "" || localStorage["username"] == null) { window.location.href = "../index.aspx"; }
    </script>
    <title>Bangkok Lottery Admin</title>
    <link rel="icon" type="image/jpeg" href="/Webimages/glo-web-icon.jpeg" />
    <link rel="shortcut icon" type="image/jpeg" href="/Webimages/glo-web-icon.jpeg" />
    <link rel="apple-touch-icon" href="/Webimages/glo-web-icon.jpeg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="Bangkok Lottery Administration" name="description" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script src="../assets/js/jquery.min.js"></script>
    <link href="assets/libs/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="assets/css/sweetalert.min.css" />
    <link rel="stylesheet" href="assets/css/toastr.min.css" />
    <link href="assets/libs/select2/css/select2.min.css" rel="stylesheet" />
    <script src="../assets/webcam.min.js"></script>
    <link href="assets/custom.css" rel="stylesheet" />
    <script>
        function hideNavbarOnMobile() { if (window.matchMedia("(max-width: 768px)").matches) { $('.hideformobile').hide(); } else { $('.hideformobile').show(); } }
        hideNavbarOnMobile(); $(window).on('resize', hideNavbarOnMobile); var url = "/"; CheckUserPagePermission()
        function dateFormatChangedmyWithMonthName(date) { var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]; var dateAr1 = date.split('-'); return dateAr1[2] + '-' + monthNames[dateAr1[1] - 1] + '-' + dateAr1[0]; }
        function removenullvalue(data) { if (data == "" || data == "null" || data == null || data == "undefined") data = ""; return data; }
        function getCurrnetdatetime() { let d = new Date(); let date = ("0" + d.getDate()).slice(-2), month = ("0" + (d.getMonth() + 1)).slice(-2), year = d.getFullYear(), hours = d.getHours(), minutes = d.getMinutes(), seconds = d.getSeconds(); return year + '-' + month + '-' + date + ' ' + hours + ':' + minutes + ':' + seconds; }
        var date = new Date(), day = date.getDate(), month = date.getMonth() + 1, year = date.getFullYear(); if (month < 10) month = "0" + month; if (day < 10) day = "0" + day; var today = year + '-' + month + '-' + day;
        var FirstDateYear = new Date(new Date().getFullYear(), 0, 1); day = FirstDateYear.getDate(); month = FirstDateYear.getMonth() + 1; year = FirstDateYear.getFullYear(); if (month < 10) month = "0" + month; if (day < 10) day = "0" + day; FirstDateYear = year + '-' + month + '-' + day; var puopmodelopen = "false";
        $(document).ready(function () { GetRolePermissionpages(); bindAdminNavigation(); setActiveAdminNavigation(); $('.cLsSuperAdmin,.clssimpleadmin,.ClsOtherUser').hide(); $("#txtDateFrom,#txtDateTo").attr("value", today); $("ul").removeClass("metismenuCls"); $('#txtinput').focus(); $(document).on('click', '.signOut', function () { localStorage.clear(); signOut(); }); $('.clsSpanUserName').html(localStorage["username"]); $(".select2_single").select2({ placeholder: "", allowClear: true }); });
        function normalizeAdminPageUrl(value) {
            if (!value) return "";
            value = String(value).split("?")[0].split("#")[0].replace(/\\/g, "/");
            value = value.substring(value.lastIndexOf("/") + 1).toLowerCase();
            return value || "dashboard.aspx";
        }

        function getSubMenuIcon(pageName, pageUrl) {
            var key = ((pageName || "") + " " + (pageUrl || "")).toLowerCase();
            if (key.indexOf("schedule") >= 0) return "mdi mdi-calendar-month-outline";
            if (key.indexOf("administration") >= 0 || key.indexOf("control") >= 0) return "mdi mdi-clipboard-text-outline";
            if (key.indexOf("result") >= 0) return "mdi mdi-trophy-outline";
            if (key.indexOf("game") >= 0) return "mdi mdi-dice-multiple-outline";
            if (key.indexOf("ball") >= 0) return "mdi mdi-numeric-8-circle-outline";
            if (key.indexOf("role") >= 0) return "mdi mdi-shield-account-outline";
            if (key.indexOf("user") >= 0 || key.indexOf("profile") >= 0) return "mdi mdi-account-outline";
            if (key.indexOf("setting") >= 0 || key.indexOf("preference") >= 0) return "mdi mdi-cog-outline";
            if (key.indexOf("audit") >= 0 || key.indexOf("log") >= 0) return "mdi mdi-format-list-bulleted";
            if (key.indexOf("report") >= 0) return "mdi mdi-chart-bar";
            return "mdi mdi-chevron-right-circle-outline";
        }

        function setActiveAdminNavigation() {
            var currentPage = normalizeAdminPageUrl(window.location.pathname);

            $(".Dynamicnavigationmenu a").removeClass("admin-current-page active");
            $(".Dynamicnavigationmenu li").removeClass("admin-current-item");

            $(".Dynamicnavigationmenu a[href]").each(function () {
                var $link = $(this);
                var href = $link.attr("href");

                if (!href || href === "#" || href.toLowerCase().indexOf("javascript:") === 0)
                    return;

                if (normalizeAdminPageUrl(href) === currentPage) {
                    $link.addClass("admin-current-page active");
                    $link.closest("li").addClass("admin-current-item");

                    var $parent = $link.closest(".admin-has-submenu");
                    if ($parent.length) {
                        $parent.addClass("admin-open mm-active");
                        $parent.children("a.admin-submenu-toggle").addClass("active");
                        $parent.children(".admin-submenu").stop(true, true).show();
                    }
                }
            });
        }

        function GetRolePermissionpages() {
            if (!(localStorage['chk'] == "true")) {
                $.ajax({
                    headers: { "Authorization": localStorage["access_token"] },
                    url: url + "api/GetRolePermission",
                    async: false,
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        localStorage['moduleNames'] = JSON.stringify(data);
                        localStorage['chk'] = "true";
                    },
                    error: function () {
                        swal({ type: 'error', title: 'Oops...', text: 'Internal Server Error [500].', showConfirmButton: false, timer: 2000 });
                    }
                });
            }

            $('.Dynamicnavigationmenu').empty().append('<li class="menu-title clstNavTitle">Navigation</li>');

            $(JSON.parse(localStorage['moduleNames'] || "[]")).each(function (index, info) {
                if (info.module_nestted_list == true) {
                    $('.Dynamicnavigationmenu').append(
                        '<li class="admin-has-submenu">' +
                            '<a href="javascript:void(0);" class="waves-effect admin-submenu-toggle">' +
                                '<i class="' + info.module_icon + '"></i>' +
                                '<span>' + info.module_name + '</span>' +
                                '<span class="menu-arrow"></span>' +
                            '</a>' +
                            '<ul class="nav-second-level admin-submenu" id="nestedlistindex' + index + '"></ul>' +
                        '</li>'
                    );

                    $(info.permission_pages || []).each(function (_, p) {
                        var subIcon = p.page_icon || p.icon || getSubMenuIcon(p.page_name, p.page_url);
                        $('#nestedlistindex' + index).append(
                            '<li>' +
                                '<a href="' + p.page_url + '" class="admin-submenu-link">' +
                                    '<i class="' + subIcon + ' admin-submenu-icon"></i>' +
                                    '<span>' + p.page_name + '</span>' +
                                '</a>' +
                            '</li>'
                        );
                    });
                } else {
                    $('.Dynamicnavigationmenu').append(
                        '<li>' +
                            '<a href="' + info.module_URL + '" class="waves-effect">' +
                                '<i class="' + info.module_icon + '"></i>' +
                                '<span>' + info.module_name + '</span>' +
                            '</a>' +
                        '</li>'
                    );
                }
            });

            setActiveAdminNavigation();
        }

        function bindAdminNavigation() {
            $(document)
                .off('click.adminnav', '.admin-submenu-toggle')
                .on('click.adminnav', '.admin-submenu-toggle', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var p = $(this).closest('.admin-has-submenu');
                    var menu = p.children('.admin-submenu');
                    var isOpen = p.hasClass('admin-open');

                    $('.admin-has-submenu').not(p)
                        .removeClass('admin-open')
                        .children('.admin-submenu')
                        .stop(true, true)
                        .slideUp(180);

                    if (isOpen) {
                        p.removeClass('admin-open');
                        menu.stop(true, true).slideUp(180);
                    } else {
                        p.addClass('admin-open');
                        menu.stop(true, true).slideDown(180);
                    }
                });
        }
        function CheckUserPagePermission() { $.ajax({ headers: { "Authorization": localStorage["access_token"] }, url: url + "api/CheckUserPagePermission?PageUrl=" + window.location.pathname, async: false, method: 'GET', dataType: 'json', success: function (data) { if (data == "false") window.location.href = '/permission_denied.html'; }, error: function () { swal({ type: 'error', title: 'Oops...', text: 'Internal Server Error [500].', showConfirmButton: false, timer: 2000 }); } }); }
    </script>
    <script src="../assets/myJquery.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" type="text/css" />
    <link href="assets/mycss.css" rel="stylesheet" />
    <link href="assets/admin-modern.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <div class="navbar-custom">
        <ul class="list-unstyled topnav-menu float-right mb-0">
            <li class="admin-global-clock-wrap">
                <div class="dash-clock admin-global-clock">
                    <span class="clock-dot"></span>
                    <div>
                        <small>THAILAND TIME (UTC+7)</small>
                        <strong id="adminThailandClock">--:--:--</strong>
                    </div>
                </div>
            </li>
            <li class="dropdown notification-list hideformobile">
                <a class="nav-link dropdown-toggle nav-user mr-0 waves-effect" data-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false"><span class="admin-avatar">A</span><span class="pro-user-name ml-2 clsSpanUserName"></span><i class="mdi mdi-chevron-down ml-1"></i></a>
                <div class="dropdown-menu dropdown-menu-right profile-dropdown">
                    <div class="dropdown-divider"></div>
                    <a href="javascript:void(0);" class="dropdown-item notify-item signOut"><i class="mdi mdi-logout-variant"></i><span>Log Out</span></a></div>
            </li>
        </ul>
        <div class="logo-box hideformobile"><a href="Dashboard.aspx" class="logo text-center logo-light"><span class="logo-lg">
            <img src="/img/glo-logo.jpeg" alt="Bangkok Lottery" class="glo-sidebar-logo" /></span><span class="logo-sm"><img src="/img/glo-logo.jpeg" alt="Bangkok Lottery" class="glo-sidebar-logo glo-sidebar-logo-sm" /></span></a></div>
        <ul class="list-unstyled topnav-menu topnav-menu-left m-0">
            <li>
                <button class="button-menu-mobile waves-effect"><i class="mdi mdi-menu"></i></button>
            </li>
            <li class="d-none d-md-inline-block"><span style="line-height: 70px; font-weight: 700; color: #172033; font-size: 14px;">Bangkok Lottery Administration</span></li>
        </ul>
    </div>
    <div class="left-side-menu">
        <div class="slimscroll-menu">
            <div id="sidebar-menu">
                <ul class="metismenu metismenuCls Dynamicnavigationmenu" id="side-menu"></ul>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
    <form id="form1" runat="server">
        <div class="admin-page-host">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">Bangkok Lottery Admin &nbsp;•&nbsp; Copyright © <%: DateTime.Now.Year %></div>
            </div>
        </div>
    </footer>
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/libs/jquery-scrollto/jquery.scrollTo.min.js"></script>
    <script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="/assets/libs/toastr/toastr.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script src="../assets/libs/select2/js/select2.min.js"></script>

    <script>
        (function () {
            function updateAdminThailandClock() {
                try {
                    var now = new Date();
                    var value = new Intl.DateTimeFormat('en-US', {
                        timeZone: 'Asia/Bangkok',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        hour12: true
                    }).format(now);

                    var el = document.getElementById('adminThailandClock');
                    if (el) el.textContent = value;
                } catch (e) { }
            }

            updateAdminThailandClock();
            window.setInterval(updateAdminThailandClock, 1000);
        })();
    </script>

</body>
</html>
