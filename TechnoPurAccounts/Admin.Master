<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="suitespk.Admin" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <script>
        if (localStorage["username"] == "" || localStorage["username"] == null) { window.location.href = "../Default.aspx"; }
    </script>
    <title>Bangkok Lottery Admin</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="Bangkok Lottery Administration" name="description" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script src="../assets/js/jquery.min.js"></script>
    <link href="assets/libs/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="assets/css/sweetalert.min.css" />
    <link rel="stylesheet" href="assets/css/toastr.min.css" />
    <link href="assets/libs/select2/css/select2.min.css" rel="stylesheet" />
    <script src="../assets/webcam.min.js"></script>
    <link href="assets/custom.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Webimages/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="~/Webimages/favicon.svg" />
    <link rel="shortcut icon" href="~/Webimages/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/Webimages/apple-touch-icon.png" />
    <script>
        function hideNavbarOnMobile(){if(window.matchMedia("(max-width: 768px)").matches){$('.hideformobile').hide();}else{$('.hideformobile').show();}}
        hideNavbarOnMobile(); $(window).on('resize',hideNavbarOnMobile); var url="/"; CheckUserPagePermission();
        function dateFormatChangedmyWithMonthName(date){var monthNames=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];var dateAr1=date.split('-');return dateAr1[2]+'-'+monthNames[dateAr1[1]-1]+'-'+dateAr1[0];}
        function removenullvalue(data){if(data==""||data=="null"||data==null||data=="undefined")data="";return data;}
        function getCurrnetdatetime(){let d=new Date();let date=("0"+d.getDate()).slice(-2),month=("0"+(d.getMonth()+1)).slice(-2),year=d.getFullYear(),hours=d.getHours(),minutes=d.getMinutes(),seconds=d.getSeconds();return year+'-'+month+'-'+date+' '+hours+':'+minutes+':'+seconds;}
        var date=new Date(),day=date.getDate(),month=date.getMonth()+1,year=date.getFullYear();if(month<10)month="0"+month;if(day<10)day="0"+day;var today=year+'-'+month+'-'+day;
        var FirstDateYear=new Date(new Date().getFullYear(),0,1);day=FirstDateYear.getDate();month=FirstDateYear.getMonth()+1;year=FirstDateYear.getFullYear();if(month<10)month="0"+month;if(day<10)day="0"+day;FirstDateYear=year+'-'+month+'-'+day;var puopmodelopen="false";
        $(document).ready(function(){GetRolePermissionpages();$('.cLsSuperAdmin,.clssimpleadmin,.ClsOtherUser').hide();$("#txtDateFrom,#txtDateTo").attr("value",today);$("ul").removeClass("metismenuCls");$('#txtinput').focus();$(document).on('click','.signOut',function(){localStorage.clear();signOut();});$('.clsSpanUserName').html(localStorage["username"]);$(".select2_single").select2({placeholder:"",allowClear:true});});
        function GetRolePermissionpages(){if(!(localStorage['chk']=="true")){$.ajax({headers:{"Authorization":localStorage["access_token"]},url:url+"api/GetRolePermission",async:false,method:'GET',dataType:'json',success:function(data){localStorage['moduleNames']=JSON.stringify(data);localStorage['chk']="true";},error:function(){swal({type:'error',title:'Oops...',text:'Internal Server Error [500].',showConfirmButton:false,timer:2000});}});}$('.Dynamicnavigationmenu').empty().append('<li class="menu-title clstNavTitle">Navigation</li>');$(JSON.parse(localStorage['moduleNames'])).each(function(index,info){if(info.module_nestted_list==true){$('.Dynamicnavigationmenu').append('<li><a href="javascript:void(0);" class="waves-effect"><i class="'+info.module_icon+'"></i><span>'+info.module_name+'</span><span class="menu-arrow"></span></a><ul class="nav-second-level" id="nestedlistindex'+index+'"></ul></li>');$(info.permission_pages).each(function(_,p){$('#nestedlistindex'+index).append('<li><a href="'+p.page_url+'">'+p.page_name+'</a></li>');});}else{$('.Dynamicnavigationmenu').append('<li><a href="'+info.module_URL+'" class="waves-effect"><i class="'+info.module_icon+'"></i><span>'+info.module_name+'</span></a></li>');}});}
        function CheckUserPagePermission(){$.ajax({headers:{"Authorization":localStorage["access_token"]},url:url+"api/CheckUserPagePermission?PageUrl="+window.location.pathname,async:false,method:'GET',dataType:'json',success:function(data){if(data=="false")window.location.href='/permission_denied.html';},error:function(){swal({type:'error',title:'Oops...',text:'Internal Server Error [500].',showConfirmButton:false,timer:2000});}});}
    </script>
    <script src="../assets/myJquery.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" type="text/css" />
    <link href="assets/mycss.css" rel="stylesheet" />
    <link href="assets/admin-modern.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <div class="navbar-custom">
        <ul class="list-unstyled topnav-menu float-right mb-0 hideformobile">
            <li class="dropdown notification-list">
                <a class="nav-link dropdown-toggle nav-user mr-0 waves-effect" data-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false"><img src="/img/logo2.png" alt="Bangkok Lottery" class="rounded-circle" /><span class="pro-user-name ml-2 clsSpanUserName"></span><i class="mdi mdi-chevron-down ml-1"></i></a>
                <div class="dropdown-menu dropdown-menu-right profile-dropdown"><div class="dropdown-divider"></div><a href="javascript:void(0);" class="dropdown-item notify-item signOut"><i class="mdi mdi-logout-variant"></i><span>Log Out</span></a></div>
            </li>
        </ul>
        <div class="logo-box hideformobile"><a href="/" class="logo text-center logo-light"><span class="logo-lg"><img src="/img/logo2.png" alt="Bangkok Lottery" style="max-width:100%;max-height:54px;" /></span><span class="logo-sm"><img src="/img/logo2.png" alt="Bangkok Lottery" style="max-width:100%;max-height:48px;" /></span></a></div>
        <ul class="list-unstyled topnav-menu topnav-menu-left m-0"><li><button class="button-menu-mobile waves-effect"><i class="mdi mdi-menu"></i></button></li><li class="d-none d-md-inline-block"><span style="line-height:70px;font-weight:700;color:#172033;font-size:14px;">Bangkok Lottery Administration</span></li></ul>
    </div>
    <div class="left-side-menu"><div class="slimscroll-menu"><div id="sidebar-menu"><ul class="metismenu metismenuCls Dynamicnavigationmenu" id="side-menu"></ul></div><div class="clearfix"></div></div></div>
    <form id="form1" runat="server"><div><asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder></div></form>
    <footer class="footer"><div class="container-fluid"><div class="row"><div class="col-md-12">Bangkok Lottery Admin &nbsp;•&nbsp; Copyright © <%: DateTime.Now.Year %></div></div></div></footer>
    <script src="/assets/js/vendor.min.js"></script><script src="/assets/libs/jquery-scrollto/jquery.scrollTo.min.js"></script><script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script><script src="/assets/libs/toastr/toastr.min.js"></script><script src="/assets/js/app.min.js"></script><script src="../assets/libs/select2/js/select2.min.js"></script>
</body>
</html>
